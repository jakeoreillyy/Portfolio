# Resend (https://resend.com) sends the contact form email
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Sender on a domain verified in Resend, e.g. Portfolio Contact <contact@example.com>.
# Leave blank to use Resend's testing sender, which only delivers to your own address
CONTACT_FROM_EMAIL=

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin). Leave blank to disable in dev
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
